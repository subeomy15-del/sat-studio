# Default: use a locally installed Ollama model. No paid service required.
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
PORT=4317

# Optional: explicitly configure an OpenAI account to use its API.
# Requests to OpenAI incur charges on that account.
# Set AI_PROVIDER=openai to prefer it over Ollama.
# OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini
