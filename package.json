{
  "name": "sat-studio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A free SAT study desk with deep lessons, focused practice, spaced review, official materials, and an optional AI tutor.",
  "engines": {
    "node": ">=24"
